{
 "doctype": "DocType",
 "name": "Litigation Case",
 "module": "LexOps Demo",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "autoname": "field:case_number",
 "title_field": "case_number",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "case_number",
   "label": "Case Number",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "client",
   "label": "Client",
   "fieldtype": "Link",
   "options": "Client",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "case_type",
   "label": "Case Type",
   "fieldtype": "Select",
   "options": "Appeal\nWrit Petition\nRevision\nAdjudication",
   "in_list_view": 1
  },
  {
   "fieldname": "authority",
   "label": "Authority",
   "fieldtype": "Link",
   "options": "Authority"
  },
  {
   "fieldname": "related_notices",
   "label": "Related Notices",
   "fieldtype": "Table MultiSelect",
   "options": "Litigation Notice",
   "description": "Multi-Link \u2014 several Litigation Notice records grouped into this case"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Open\nClosed",
   "in_list_view": 1,
   "default": "Open"
  },
  {
   "fieldname": "current_stage",
   "label": "Current Stage",
   "fieldtype": "Select",
   "options": "Notice Received\nAI Extracted\nReply Drafted\nReply Filed\nHearing Scheduled\nAdjudication\nFinal Order",
   "description": "Mirrors the seven-stage litigation spine"
  },
  {
   "fieldname": "assigned_consultant",
   "label": "Assigned Consultant",
   "fieldtype": "Link",
   "options": "Consultant"
  },
  {
   "fieldname": "final_order",
   "label": "Final Order",
   "fieldtype": "Attach",
   "description": "Judgement / final adjudication document"
  },
  {
   "fieldname": "hearings",
   "label": "Hearings",
   "fieldtype": "Table",
   "options": "Hearing"
  },
  {
   "fieldname": "orders",
   "label": "Orders",
   "fieldtype": "Table",
   "options": "Order"
  },
  {
   "fieldname": "appeals",
   "label": "Appeals",
   "fieldtype": "Table",
   "options": "Appeal"
  },
  {
   "fieldname": "supporting_documents",
   "label": "Supporting Documents",
   "fieldtype": "Table",
   "options": "Supporting Document"
  },
  {
   "fieldname": "final_closure",
   "label": "Final Closure",
   "fieldtype": "Table",
   "options": "Final Closure"
  }
 ],
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1,
   "permlevel": 0
  }
 ]
}
