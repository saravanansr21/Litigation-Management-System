   "unique": 1,
   "in_list_view": 1,
   "description": "ASMT-10, DRC-01, DRC-01A, DRC-07, GSTR-3A, ADT-01, RFD-08, MOV-07, REG-17"
  },
  {
   "fieldname": "label",
   "label": "Label",
   "fieldtype": "Data",
   "in_list_view": 1,
   "description": "e.g. \"Show Cause Notice\", \"Scrutiny Notice\""
  },
  {
   "fieldname": "applicable_section",
   "label": "Applicable Section",
   "fieldtype": "Data",
   "description": "e.g. Section 61, Section 73/74, Rule 142(1A), Section 129"
