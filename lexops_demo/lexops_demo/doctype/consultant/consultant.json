{
 "doctype": "DocType",
 "name": "Consultant",
 "module": "LexOps Demo",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "title_field": "consultant_name",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "CONS-.#####",
   "hidden": 1
  },
  {
   "fieldname": "consultant_name",
   "label": "Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "description": "e.g. \"CA Rakesh Nair\", \"Adv. Preethi Subramaniam\""
  },
  {
   "fieldname": "user",
   "label": "User",
   "fieldtype": "Link",
   "options": "User",
   "description": "Login credential, if the consultant is internal staff with platform access"
  },
  {
   "fieldname": "title",
   "label": "Title",
   "fieldtype": "Data",
   "description": "e.g. \"Senior GST Consultant\", \"Sr. Counsel \u2014 GST Fraud\""
  },
  {
   "fieldname": "firm_chamber",
   "label": "Firm / Chamber",
   "fieldtype": "Data",
   "description": "e.g. \"Nair & Associates, Pune\""
  },
  {
   "fieldname": "specialisation",
   "label": "Specialisation",
   "fieldtype": "Data"
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "avatar_initials_colour",
   "label": "Avatar Initials / Colour",
   "fieldtype": "Data"
  },
  {
   "fieldname": "active",
   "label": "Active",
   "fieldtype": "Check",
   "in_list_view": 1,
   "default": 1
  }
 ],
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1,
   "permlevel": 0
  }
 ]
}
