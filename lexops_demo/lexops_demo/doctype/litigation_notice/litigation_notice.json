{
 "doctype": "DocType",
 "name": "Litigation Notice",
 "module": "LexOps Demo",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "autoname": "field:notice_id",
 "title_field": "notice_id",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "notice_id",
   "label": "Notice ID",
   "fieldtype": "Data",
   "unique": 1,
   "read_only": 1,
   "in_list_view": 1,
   "description": "Auto-generated composite: state code + financial year + form + sequence (e.g. MH2024DRC01001)"
  },
  {
   "fieldname": "client",
   "label": "Client",
   "fieldtype": "Link",
   "options": "Client",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "gst_registration",
   "label": "GST Registration",
   "fieldtype": "Link",
   "options": "GST Registration",
   "reqd": 1
  },
  {
   "fieldname": "notice_type",
   "label": "Notice Type / Form",
   "fieldtype": "Link",
   "options": "Notice Type",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section",
   "label": "Section",
   "fieldtype": "Data",
   "read_only": 1,
   "description": "Auto-filled from Notice Type"
  },
  {
   "fieldname": "financial_year",
   "label": "Financial Year",
   "fieldtype": "Select",
   "options": "2021-22\n2022-23\n2023-24\n2024-25"
  },
  {
   "fieldname": "issue_filed_date",
   "label": "Issue / Filed Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "due_date",
   "label": "Due Date",
   "fieldtype": "Date",
   "read_only": 1,
   "description": "Auto-computed: Issue Date + statutory window from Notice Type"
  },
  {
   "fieldname": "reply_form",
   "label": "Reply Form",
   "fieldtype": "Data",
   "read_only": 1,
   "description": "Auto-filled from Notice Type"
  },
  {
   "fieldname": "tax_amount",
   "label": "Tax Amount",
   "fieldtype": "Currency"
  },
  {
   "fieldname": "interest_amount",
   "label": "Interest",
   "fieldtype": "Currency"
  },
  {
   "fieldname": "penalty_amount",
   "label": "Penalty",
   "fieldtype": "Currency"
  },
  {
   "fieldname": "total_demand",
   "label": "Total Demand",
   "fieldtype": "Currency",
   "read_only": 1,
   "description": "Computed: sum of Tax Amount + Interest + Penalty"
  },
  {
   "fieldname": "risk_level",
   "label": "Risk Level",
   "fieldtype": "Select",
   "options": "Critical\nHigh\nMedium\nLow",
   "in_list_view": 1
  },
  {
   "fieldname": "priority",
   "label": "Priority",
   "fieldtype": "Select",
   "options": "Low\nMedium\nHigh\nUrgent"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Active\nUnder Review\nResponded\nHearing Scheduled\nEscalated\nResolved",
   "in_list_view": 1,
   "default": "Active"
  },
  {
   "fieldname": "workflow_stage",
   "label": "Workflow Stage",
   "fieldtype": "Select",
   "options": "Notice Received\nAI Extracted\nReply Drafted\nReply Filed\nHearing Scheduled\nAdjudication\nFinal Order",
   "default": "Notice Received"
  },
  {
   "fieldname": "assigned_consultant",
   "label": "Assigned Consultant",
   "fieldtype": "Link",
   "options": "Consultant"
  },
  {
   "fieldname": "ai_summary",
   "label": "AI Summary",
   "fieldtype": "Long Text"
  },
  {
   "fieldname": "original_notice",
   "label": "Original Notice",
   "fieldtype": "Attach",
   "description": "Source PDF as received"
  },
  {
   "fieldname": "reply_document",
   "label": "Reply Document",
   "fieldtype": "Attach",
   "description": "Final filed response PDF"
  },
  {
   "fieldname": "litigation_case",
   "label": "Litigation Case",
   "fieldtype": "Link",
   "options": "Litigation Case",
   "description": "Set once this notice is grouped into a formal case"
  },
  {
   "fieldname": "notice_attachments",
   "label": "Notice Attachments",
   "fieldtype": "Table",
   "options": "Notice Attachment"
  },
  {
   "fieldname": "ai_extractions",
   "label": "AI Extractions",
   "fieldtype": "Table",
   "options": "AI Extraction"
  },
  {
   "fieldname": "ai_prompt_history",
   "label": "AI Prompt History",
   "fieldtype": "Table",
   "options": "AI Prompt History"
  },
  {
   "fieldname": "replies",
   "label": "Replies",
   "fieldtype": "Table",
   "options": "Reply"
  },
  {
   "fieldname": "deadlines",
   "label": "Deadlines",
   "fieldtype": "Table",
   "options": "Deadline"
  },
  {
   "fieldname": "supporting_documents",
   "label": "Supporting Documents",
   "fieldtype": "Table",
   "options": "Supporting Document"
  }
 ],
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1,
   "permlevel": 0
  }
 ]
}
