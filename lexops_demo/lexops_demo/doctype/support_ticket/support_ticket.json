{
 "doctype": "DocType",
 "name": "Support Ticket",
 "module": "LexOps Demo",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "naming_rule": "By \"Naming Series\" field",
 "autoname": "naming_series:",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "TICKET-.YYYY.-.#####",
   "hidden": 1
  },
  {
   "fieldname": "raised_by",
   "label": "Raised By",
   "fieldtype": "Link",
   "options": "User",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "subject",
   "label": "Subject",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "description",
   "label": "Description",
   "fieldtype": "Text"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Open\nIn Progress\nResolved\nClosed",
   "in_list_view": 1,
   "default": "Open"
  },
  {
   "fieldname": "priority",
   "label": "Priority",
   "fieldtype": "Select",
   "options": "Low\nMedium\nHigh\nUrgent",
   "default": "Medium"
  }
 ],
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1,
   "permlevel": 0
  }
 ]
}
