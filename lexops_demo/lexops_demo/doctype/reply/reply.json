{
 "doctype": "DocType",
 "name": "Reply",
 "module": "LexOps Demo",
 "custom": 0,
 "istable": 1,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "notice",
   "label": "Notice",
   "fieldtype": "Link",
   "options": "Litigation Notice"
  },
  {
   "fieldname": "draft_text",
   "label": "Draft Text",
   "fieldtype": "Long Text"
  },
  {
   "fieldname": "version",
   "label": "Version",
   "fieldtype": "Int",
   "default": 1
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Draft\nApproved\nFiled",
   "in_list_view": 1,
   "default": "Draft"
  },
  {
   "fieldname": "approved_by",
   "label": "Approved By",
   "fieldtype": "Link",
   "options": "User",
   "description": "Must be a user with the CA role"
  },
  {
   "fieldname": "approved_on",
   "label": "Approved On",
   "fieldtype": "Datetime"
  },
  {
   "fieldname": "filed_document",
   "label": "Filed Document",
   "fieldtype": "Attach"
  }
 ]
}
