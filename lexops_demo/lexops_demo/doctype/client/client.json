{
 "doctype": "DocType",
 "name": "Client",
 "module": "LexOps Demo",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "naming_rule": "By fieldname",
 "autoname": "field:client_code",
 "title_field": "client_name",
 "sort_field": "modified",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "client_name",
   "label": "Client Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "short_name",
   "label": "Short Name",
   "fieldtype": "Data"
  },
  {
   "fieldname": "client_code",
   "label": "Client Code",
   "fieldtype": "Data",
   "reqd": 1,
   "unique": 1
  },
  {
   "fieldname": "pan",
   "label": "PAN",
   "fieldtype": "Data"
  },
  {
   "fieldname": "company_type",
   "label": "Company Type",
   "fieldtype": "Select",
   "options": "Pvt Ltd\nPublic Ltd\nLLP\nPartnership\nProprietorship"
  },
  {
   "fieldname": "industry",
   "label": "Industry / Sector",
   "fieldtype": "Link",
   "options": "Industry"
  },
  {
   "fieldname": "contact_person",
   "label": "Contact Person",
   "fieldtype": "Data"
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data"
  },
  {
   "fieldname": "registered_address",
   "label": "Registered Address",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Active\nInactive\nOnboarding",
   "in_list_view": 1,
   "default": "Onboarding"
  },
  {
   "fieldname": "onboarding_stage",
   "label": "Onboarding Stage",
   "fieldtype": "Select",
   "options": "Scoping call\nEngagement letter sent\nGSTIN authorisation pending",
   "description": "Only meaningful while Status = Onboarding"
  },
  {
   "fieldname": "onboarding_date",
   "label": "Onboarding Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "default_consultant",
   "label": "Default Consultant",
   "fieldtype": "Link",
   "options": "Consultant"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Text"
  },
  {
   "fieldname": "client_contacts",
   "label": "Client Contacts",
   "fieldtype": "Table",
   "options": "Client Contact"
  },
  {
   "fieldname": "client_addresses",
   "label": "Client Addresses",
   "fieldtype": "Table",
   "options": "Client Address"
  },
  {
   "fieldname": "client_documents",
   "label": "Client Documents",
   "fieldtype": "Table",
   "options": "Client Documents"
  }
 ],
 "permissions": [
  {
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "read": 1,
   "report": 1,
   "role": "System Manager",
   "share": 1,
   "write": 1,
   "permlevel": 0
  }
 ]
}
